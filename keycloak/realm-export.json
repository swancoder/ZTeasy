{
  "id": "zte-realm",
  "realm": "zte-realm",
  "displayName": "ZTE Lightweight",
  "displayNameHtml": "<b>ZTE</b> Lightweight",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "ZTE Administrator \u2014 full access to all gateway-protected resources",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "USER",
        "description": "Standard ZTE user \u2014 read-only access to gateway-protected resources",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "CEO",
        "description": "Executive overview \u2014 governance posture across all agents",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "CFO",
        "description": "Cost view \u2014 LLM spend and token metering",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "CTO",
        "description": "Operational view \u2014 agent activity, registry and health",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "BOARD",
        "description": "Board/Risk view \u2014 risk tiers, overdue re-authorizations, out-of-policy attempts",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "DPO",
        "description": "Data-protection view \u2014 data scopes, PII fields and holds involving personal data",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "APPROVER",
        "description": "May decide held calls that a policy rule routes to role:APPROVER (ADR-034)",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      }
    ],
    "client": {}
  },
  "clients": [
    {
      "clientId": "zte-gateway",
      "name": "ZTE Gateway",
      "description": "Confidential OIDC client for the ZTE API Gateway service. Supports authorization code (UI) and client credentials (service-to-service) flows.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "__ZTE_SECRET_ZTE_GATEWAY__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "https://localhost:8080/*",
        "https://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "https://localhost:8080"
      ],
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agent-a",
      "name": "MCP Agent A",
      "description": "Confidential OIDC client for Agent A (hubspot-mcp). Client Credentials grant only \u2014 no interactive user flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "__ZTE_SECRET_AGENT_A__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "agent-b",
      "name": "MCP Agent B",
      "description": "Confidential OIDC client for Agent B (hubspot-mcp). Client Credentials grant only \u2014 no interactive user flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "__ZTE_SECRET_AGENT_B__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "service-a",
      "name": "Service A (gateway-fronted service2service identity)",
      "description": "Confidential OIDC client (ADR-017) for gateway-fronted service2service calls as 'service-a'. Distinct from service-a's own internal direct-mTLS call to service-b. Client Credentials grant only.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "__ZTE_SECRET_SERVICE_A__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "crm-account-health-emea-01",
      "name": "Account-Health Assistant (Nordwind Components demo)",
      "description": "Account-Health Assistant agent for the ACAP CRM demo (ADR-019/ADR-020): read-only, EMEA. Client Credentials only. Full ACAP profile: examples-from-vlad/acap-crm-account-health.json",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "__ZTE_SECRET_CRM_ACCOUNT_HEALTH_EMEA_01__",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "zte-approver-ui",
      "name": "ZTE Approval Center",
      "description": "Public OIDC client (PKCE) for the standalone Approval Center SPA at /approver/ (ADR-026). Any authenticated realm user may decide held calls.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "https://localhost:8080/approver/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "zte-admin-ui",
      "name": "ZTE Admin Console",
      "description": "Public OIDC client (PKCE) for the React admin SPA (ADR-012), served statically by the gateway at /admin/.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "https://localhost:8080/admin/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
