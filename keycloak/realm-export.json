{
  "id": "zte-realm",
  "realm": "zte-realm",
  "displayName": "ZTE Lightweight",
  "displayNameHtml": "<b>ZTE</b> Lightweight",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,

  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "ZTE Administrator — full access to all gateway-protected resources",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      },
      {
        "name": "USER",
        "description": "Standard ZTE user — read-only access to gateway-protected resources",
        "composite": false,
        "clientRole": false,
        "containerId": "zte-realm"
      }
    ],
    "client": {}
  },

  "clients": [
    {
      "clientId": "zte-gateway",
      "name": "ZTE Gateway",
      "description": "Confidential OIDC client for the ZTE API Gateway service. Supports authorization code (UI) and client credentials (service-to-service) flows.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "zte-gateway-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agent-a",
      "name": "MCP Agent A",
      "description": "Confidential OIDC client for Agent A (hubspot-mcp). Client Credentials grant only — no interactive user flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-a-secret-dev-only",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "agent-b",
      "name": "MCP Agent B",
      "description": "Confidential OIDC client for Agent B (hubspot-mcp). Client Credentials grant only — no interactive user flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-b-secret-dev-only",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "service-a",
      "name": "Service A (gateway-fronted service2service identity)",
      "description": "Confidential OIDC client (ADR-017) for gateway-fronted service2service calls as 'service-a'. Distinct from service-a's own internal direct-mTLS call to service-b. Client Credentials grant only.",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "service-a-s2s-secret-dev-only",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false
    },
    {
      "clientId": "zte-admin-ui",
      "name": "ZTE Admin Console",
      "description": "Public OIDC client (PKCE) for the React admin SPA (ADR-012), served statically by the gateway at /admin/.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:8080/admin/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "zte-admin",
      "email": "zte-admin@zte.local",
      "firstName": "ZTE",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [],
      "requiredActions": [],
      "realmRoles": [
        "ADMIN"
      ],
      "clientRoles": {}
    },
    {
      "username": "zte-test-user",
      "email": "zte-test-user@zte.local",
      "firstName": "ZTE",
      "lastName": "TestUser",
      "enabled": true,
      "emailVerified": true,
      "credentials": [],
      "requiredActions": [],
      "realmRoles": [
        "USER"
      ],
      "clientRoles": {}
    },
    {
      "username": "service-account-zte-gateway",
      "serviceAccountClientId": "zte-gateway",
      "enabled": true,
      "clientRoles": {
        "realm-management": ["view-users", "view-realm", "view-clients"]
      }
    }
  ]
}
